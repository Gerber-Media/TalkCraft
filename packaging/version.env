# TalkCraft's version: TALKCRAFT_MINOR.<commits since TALKCRAFT_FORK_BASE>, e.g. 0.1.48.
# The single place to change it: raise TALKCRAFT_MINOR for bigger steps (e.g. 1.0 for the first
# release); the last number counts up by itself with every commit. Read by the app and CLI
# (crates/engine/build.rs) and by every packaging script (env.sh, package.ps1, the Flatpak).
TALKCRAFT_MINOR=0.9
TALKCRAFT_FORK_BASE=6cf896e76c0ec82a11bf2494f209cfe7c8507f74
